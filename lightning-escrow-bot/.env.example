# ──────────────────────────────────────────────────────────────────────────────
# TELEGRAM CREDENTIALS
# ──────────────────────────────────────────────────────────────────────────────
# The master token from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# A random string you invent to secure your webhooks (e.g. sk_live_894fhq984h)
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# Your personal Telegram numeric ID (use @userinfobot to find yours)
ADMIN_TELEGRAM_ID=your_numeric_telegram_id

# The public HTTPS URL of your Railway server (NO trailing slash!)
# e.g. https://my-escrow-bot.up.railway.app (Use your Ngrok URL for local dev)
WEBHOOK_DOMAIN=https://your-production-url.com

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE (DATABASE)
# ──────────────────────────────────────────────────────────────────────────────
# Found in your Supabase Dashboard -> Project Settings -> API
SUPABASE_PROJECT_URL=https://your-project-id.supabase.co

# MUST be the "service_role" secret. NEVER use the public "anon" key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ──────────────────────────────────────────────────────────────────────────────
# BLINK (LIGHTNING API)
# ──────────────────────────────────────────────────────────────────────────────
# The production GraphQL endpoint
BLINK_GRAPHQL_ENDPOINT=https://api.blink.sv/graphql

# Generate this at dev.blink.sv (Requires Invoice generation + payout scopes)
BLINK_API_KEY=your_blink_api_key

# ──────────────────────────────────────────────────────────────────────────────
# PLATFORM ECONOMICS
# ──────────────────────────────────────────────────────────────────────────────
# Decimal representation of your cut (e.g. 0.02 = 2%)
PLATFORM_FEE_PERCENTAGE=0.02

# The absolute minimum sats you take per trade to cover routing
PLATFORM_FEE_MIN_SATS=500

# ──────────────────────────────────────────────────────────────────────────────
# SERVER (Local Dev Only)
# ──────────────────────────────────────────────────────────────────────────────
# Railway sets this automatically in production, but we need it for localhost
PORT=3000