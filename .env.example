# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express service listens on.
PORT=3000

# Public base URL where this service is hosted (no trailing slash).
# Used to build canonical endpoints and the PIP-01 descriptor service.endpoint.
SERVICE_BASE_URL=https://escrow.example.com

# Public path prefix for the escrow HTTP interface.
SERVICE_PATH_PREFIX=/pontmore/v1

# Interface and version identifier advertised in the descriptor.
SERVICE_INTERFACE=pontmore_escrow_http_v1

# Comma-separated list of accepted release-decision formats.
# Must be a subset of: mutual_consent, operator_decision, oracle_signature,
# application_signed_result, threshold_participant_signatures
ACCEPTED_RELEASE_DECISIONS=mutual_consent,operator_decision,application_signed_result

# Application identities (npub/hex pubkeys) authorised to submit
# application_signed_result release decisions. Comma-separated.
APPLICATION_SIGNER_PUBKEYS=

# Operator Nostr pubkey (npub or hex) and nsec (private key).
# The nsec is used for signing escrow descriptor events (kind 30361)
# for publication to Nostr relays so the service is discoverable.
OPERATOR_PUBKEY=
OPERATOR_NSEC=

# Funding model advertised in the descriptor.
# One of: single_funder, two_party, n_of_m
# This is the DEFAULT model used when a create request omits funding_model.
FUNDING_MODEL=single_funder

# Comma-separated list of funding models this deployment accepts per-instance.
# Defaults to all three. Restrict to e.g. "single_funder,two_party" to disable n_of_m.
ACCEPTED_FUNDING_MODELS=single_funder,two_party,n_of_m

# For n_of_m only: M (minimum required funded participants) and N (total declared participants).
# These serve as defaults when a create request omits explicit threshold/count.
# Leave blank if n_of_m is not in ACCEPTED_FUNDING_MODELS.
# Example n_of_m: FUNDING_THRESHOLD=3, PARTICIPANT_COUNT=5
FUNDING_THRESHOLD=
PARTICIPANT_COUNT=

# Maximum accepted age (seconds) of a NIP-98 auth event.
NIP98_MAX_AGE_SECONDS=60

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Blink API (Lightning custody) ─────────────────────────────────────────────
BLINK_GRAPHQL_ENDPOINT=https://graphql.blink.sv/graphql
BLINK_API_KEY=

# ── Platform Fee ──────────────────────────────────────────────────────────────
# Straight decimal percentage of the escrow amount, paid by the funder.
# e.g. 0.02 = 2%.
PLATFORM_FEE_PERCENTAGE=0.02

# Default fiat currency used for amount conversion helpers.
FIAT_CURRENCY=KES
